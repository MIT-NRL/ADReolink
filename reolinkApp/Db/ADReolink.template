include "ADBase.template"

record(mbbo, "$(P)$(R)PTZDirection") {
    field(DESC, "PTZ movement command")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))REOLINK_PTZ_DIRECTION")
    field(ZRST, "Stop")
    field(ONST, "Up")
    field(ONVL, "1")
    field(TWST, "Down")
    field(TWVL, "2")
    field(THST, "Left")
    field(THVL, "3")
    field(FRST, "Right")
    field(FRVL, "4")
    field(FVST, "Left Up")
    field(FVVL, "5")
    field(SXST, "Right Up")
    field(SXVL, "6")
    field(SVST, "Left Down")
    field(SVVL, "7")
    field(EIST, "Right Down")
    field(EIVL, "8")
}

record(mbbi, "$(P)$(R)PTZDirection_RBV") {
    field(DESC, "Current PTZ movement")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))REOLINK_PTZ_DIRECTION")
    field(SCAN, "I/O Intr")
    field(ZRST, "Stop")
    field(ONST, "Up")
    field(ONVL, "1")
    field(TWST, "Down")
    field(TWVL, "2")
    field(THST, "Left")
    field(THVL, "3")
    field(FRST, "Right")
    field(FRVL, "4")
    field(FVST, "Left Up")
    field(FVVL, "5")
    field(SXST, "Right Up")
    field(SXVL, "6")
    field(SVST, "Left Down")
    field(SVVL, "7")
    field(EIST, "Right Down")
    field(EIVL, "8")
}

